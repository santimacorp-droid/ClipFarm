# AutoClip Environment Configuration Example
# Copy this file to .env and configure your variables

# Database Configuration
DATABASE_URL=sqlite:///data/autoclip.db

# Redis Configuration (for Celery background tasks)
REDIS_URL=redis://localhost:6379/0

# LLM Provider Configuration ('ollama', 'custom', 'dashscope', 'openai', 'gemini', 'siliconflow')
LLM_PROVIDER=ollama

# Local Ollama / LM Studio / LocalAI Settings (100% Free & Local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
API_MODEL_NAME=llama3.2
MODEL_NAME=llama3.2

# Custom OpenAI-Compatible Endpoints (DeepSeek, OpenRouter, vLLM, Groq)
CUSTOM_BASE_URL=https://api.deepseek.com/v1
CUSTOM_API_KEY=your_custom_api_key_here

# Official OpenAI API Settings
OPENAI_API_KEY=your_openai_api_key_here
API_OPENAI_API_KEY=your_openai_api_key_here

# Alibaba DashScope (Qwen) API Settings
API_DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODE=qwen
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
API_MAX_TOKENS=1500
API_TIMEOUT=60

# Google Gemini API Settings (Alternative LLM Provider)
GEMINI_API_KEY=your_gemini_api_key_here
API_GEMINI_API_KEY=your_gemini_api_key_here

# SiliconFlow API Settings
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# Pipeline Processing Settings
PROCESSING_CHUNK_SIZE=3000
PROCESSING_MIN_SCORE_THRESHOLD=0.7
PROCESSING_MAX_CLIPS_PER_COLLECTION=10
PROCESSING_MAX_RETRIES=3

# Logging and Runtime Environment
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/autoclip.log
ENVIRONMENT=development
DEBUG=false
